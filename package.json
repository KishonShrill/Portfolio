{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "packageManager": "npm@12.1.0",
    "dependencies": {
        "@vinext/cloudflare": "^1.0.1",
        "clsx": "^2.1.1",
        "neverthrow": "^8.2.0",
        "react": "latest",
        "react-dom": "latest",
        "react-server-dom-webpack": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "vinext": "^1.0.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@tailwindcss/postcss": "latest",
        "@types/node": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitejs/plugin-rsc": "^0.5.35",
        "cf": "^1.0.0-beta.12",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "tailwindcss": "latest",
        "typescript": "latest",
        "vite": "^8.3.2",
        "wrangler": "^4.147.0"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
    },
    "type": "module",
    "scripts": {
        "dev": "vite dev --host 0.0.0.0 --port 3000",
        "dev:start": "wrangler dev --ip 0.0.0.0 --port 3000 --config dist/server/wrangler.json",
        "prebuild": "npm run cf-typegen",
        "build": "vite build",
        "start": "vite preview",
        "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
        "prepare": "husky",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    }
}
